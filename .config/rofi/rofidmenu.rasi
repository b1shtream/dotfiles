/*******************************************************
 * Modern centered app launcher (icons + search)
 * Used by: $mod+d  (rofi -show drun -config this-file)
 *******************************************************/

configuration {
    font:                "JetBrainsMono Nerd Font 11";
    show-icons:          true;
    icon-theme:          "Qogir-Dark";
    display-drun:        "";
    drun-display-format: "{name}";
    scroll-method:       0;
    disable-history:     false;
    sidebar-mode:        false;
}

* {
    bg:        #1d2021;   /* near-black, matches gruvbox-hard / terminal */
    bg-alt:    #282828;
    fg:        #ebdbb2;
    fg-dim:    #a89984;
    accent:    #83a598;   /* aqua/blue accent */
    urgent:    #fb4934;
    selbg:     #3c3836;

    background-color: transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            640px;
    border-radius:    14px;
    background-color: @bg;
    padding:          0;
}

mainbox {
    padding:  18px;
    spacing:  14px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          12px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    str:        "";          /* search glyph (Nerd Font) */
}

entry {
    placeholder:       "Search…";
    placeholder-color: @fg-dim;
    text-color:        @fg;
    cursor:            text;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    spacing:      4px;
    cycle:        true;
    dynamic:      true;
}

element {
    padding:       10px 14px;
    spacing:       12px;
    border-radius: 8px;
    text-color:    @fg;
}

element selected {
    background-color: @selbg;
    text-color:       @accent;
}

element-icon {
    size:             26px;
    background-color: transparent;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
